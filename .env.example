# Скопируйте в .env и поменяйте значения. Без .env используются демо-значения.
SECRET_KEY=change-me-in-production
POSTGRES_PASSWORD=kabinet

# Сбои моков для демонстрации надёжности (0..1)
FNS_FAIL_RATE=0
BKI_FAIL_RATE=0

# Пауза между этапами конвейера, чтобы в демо было видно движение статуса (сек.)
PIPELINE_STEP_DELAY=0.8

# LLM с открытыми весами (только объяснение решения). Пусто — детерминированный текст.
# С профилем llm:  LLM_URL=http://ollama:11434
LLM_URL=
LLM_MODEL=qwen2.5:1.5b
