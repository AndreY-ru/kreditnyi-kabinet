# Скопируйте в .env и поменяйте значения. Без .env используются демо-значения.
SECRET_KEY=change-me-in-production
POSTGRES_PASSWORD=kabinet

# Сбои моков для демонстрации надёжности (0..1)
FNS_FAIL_RATE=0
BKI_FAIL_RATE=0

# Пауза между этапами конвейера, чтобы в демо было видно движение статуса (сек.)
PIPELINE_STEP_DELAY=0.8

# LLM с открытыми весами: подбор по описанию своими словами и черновики сообщений клиенту.
# Включить: раскомментируйте строку ниже (или запускайте с флагом --profile llm). Модель скачается сама, ~2,5 ГБ.
# COMPOSE_PROFILES=llm
# Модель — точная сборка, на которой делали замер (docs/llm.md):
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# LLM_URL=  — пустое значение отключает модель, даже если контейнер ollama запущен
